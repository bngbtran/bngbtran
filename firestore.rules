rules_version = '2';

// Ai cũng đọc được (để hiển thị portfolio).
// Chỉ tài khoản quản trị (đúng email, đã xác minh) mới được ghi.
// Danh sách email phải khớp với ADMIN_EMAILS trong assets/js/config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ["tranbnb.2004@gmail.com", "buitran20042003@gmail.com"]
        && request.auth.token.email_verified == true;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
