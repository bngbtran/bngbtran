rules_version = '2';

// Ai cũng đọc được (để hiển thị portfolio).
// Chỉ tài khoản quản trị (đúng email, đã xác minh) mới được ghi.
// Email phải khớp với ADMIN_EMAIL trong assets/js/config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "tranbnb.2004@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
